        {
          "Title": "Builder",
          "Commands": [
            "raidbuilderinfo",
            "raidbuildinfo",
            "raidguide"
          ],
          "Columns": [
            {
              "Blocks": [
                {
                  "Heading": "RAIDBASE BUILDER HELP",
                  "Lines": [
                    {
                      "Text": "Raidbase builder access is admin-only after vetting. This is not a public toy box.",
                      "Tone (body, accent, warn, muted)": "warn"
                    },
                    {
                      "Text": "Players approved to help build or test raidbase content.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Permissions are assigned by an admin only after vetting.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Do not share commands, bases, or access with unapproved players.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "/raidbasestart — start or set up a player raidbase build session",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "/raidreadypve — mark the saved raidbase ready for PvE use",
