                  "Heading": "PVP ZONES",
                  "Lines": [
                    {
                      "Text": "Monuments are always PvP. Watch the zone warnings before entering.",
                      "Tone (body, accent, warn, muted)": "warn"
                    },
                    {
                      "Text": "Event domes and PvP-marked areas may also allow player combat.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "The weekend window is Friday 8:00 PM through Monday 3:00 AM Eastern. Home shows whether it is open.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Purge is separate. It is an admin toggle for the end of wipe, not the weekend window.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Watch entry and exit messages.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Watch dome and warning visuals.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Watch Purge announcements during the last days of wipe.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "When the server tells you an area is PvP, believe it.",
                      "Tone (body, accent, warn, muted)": "warn"
                    }
                  ]
                }
              ]
