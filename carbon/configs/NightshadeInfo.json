      "Tabs": [
        {
          "Title": "Perks",
          "Commands": [
            "vip",
            "vipinfo"
          ],
          "Columns": [
            {
              "Blocks": [
                {
                  "Heading": "TRAVEL",
                  "Lines": [
                    {
                      "Text": "VIP: 4 homes. Default is 3. Home cooldown and countdown are 5 seconds, down from 10.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "VIPx: 5 homes, with no home cooldown or countdown.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Home teleports do not cost RP for anyone. VIP is not a waived fee.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Homes on tugboats are allowed for everyone.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "VIPx can use /tug and /tugboat with a free vehicle license. A resource-bought tugboat is not VIP-only.",
                      "Tone (body, accent, warn, muted)": "body"
                    }
                  ]
                },
                {
                  "Heading": "QUEUE & KITS",
                  "Lines": [
                    {
                      "Text": "VIP gets a reconnect grace. VIPx gets the queue skip. They are not the same perk.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "/perks shows crate time and kit status. /perks daily and /perks 4day claim the kits.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Kits stay locked for 48 hours after wipe.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Hackable crates: 2.5 minutes for VIP, 60 seconds for VIPx.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "/afk is VIP and VIPx only.",
                      "Tone (body, accent, warn, muted)": "body"
                    }
                  ]
                },
                {
                  "Heading": "ECONOMY & REWARDS",
                  "Lines": [
                    {
                      "Text": "Heli signal rewards: 1.25× for VIP, 1.5× for VIPx.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "A 1.1× activity-reward multiplier exists, but that permission is not on the VIP group.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Bradley cooldown cuts are configured for permissions the VIP groups do not have, and Bradley RP rewards are disabled. Do not count on a shorter Bradley cooldown.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Chest stacks: 2 small and 3 large by default, 5 and 5 for VIP.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "The VIP shop category has claimable tools: iron axe and pickaxe for VIP, salvaged axe and pickaxe for VIPx, plus a one-per-wipe 4-socket chassis for 7000 RP.",
                      "Tone (body, accent, warn, muted)": "body"
                    }
                  ]
                }
              ]
            },
            {
              "Blocks": [
                {
                  "Heading": "GAMEPLAY",
                  "Lines": [
                    {
                      "Text": "No decay on personal boats and tugboats for VIP.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Some cosmetic and building skin perks are VIP gated.",
                      "Tone (body, accent, warn, muted)": "body"
                    }
                  ]
                },
                {
                  "Heading": "EARLY WIPE ACCESS",
                  "Lines": [
                    {
                      "Text": "Easy raids are immediate for everyone.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Default unlocks: Medium 24h, Hard 72h, Expert 120h, Nightmare 168h.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Shorter times (12h, 48h, 96h, 144h) are configured, and those permissions are not on the VIP group. VIP alone does not unlock them early.",
                      "Tone (body, accent, warn, muted)": "body"
                    }
                  ]
                }
              ]
            }
