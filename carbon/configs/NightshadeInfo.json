                    },
                    {
                      "Text": "/raidreadypvp — mark the saved raidbase ready for PvP use",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "/raidbaseend — end or clean up the active raidbase session",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Build clean, playable bases with accessible paths and fair loot flow.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Avoid traps that softlock players, exploit terrain, or create impossible raid paths.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Ask an admin before making major format changes.",
                      "Tone (body, accent, warn, muted)": "body"
                    }
