      ],
      "Tabs": [
        {
          "Title": "Overview",
          "Commands": [
            "events",
            "eventinfo",
            "help"
          ],
          "Columns": [
            {
              "Blocks": [
                {
                  "Heading": "REGULAR EVENTS",
                  "Lines": [
                    {
                      "Text": "Hide and Seek runs on scheduled event days when announced.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Purge is the last stretch of wipe, started by an admin: PvP, raiding, and base destruction are allowed serverwide.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Monuments are always PvP. Watch the zone warnings.",
                      "Tone (body, accent, warn, muted)": "warn"
                    }
                  ]
                },
                {
                  "Heading": "SIGNALS / BOSSES",
                  "Lines": [
                    {
                      "Text": "Heli and Bradley signals may have tiers, cooldowns, rewards, and team recommendations.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Read event warnings before throwing expensive signals like a gremlin with fireworks.",
                      "Tone (body, accent, warn, muted)": "body"
                    }
                  ]
                }
              ]
            },
            {
              "Blocks": [
                {
                  "Heading": "SIGNALS / RAID CONTENT",
                  "Lines": [
                    {
                      "Text": "Bradley and Heli signals are player-triggered combat events. Bradley buys spend RP.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Raidable Bases are event bases, not normal player bases.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "Read difficulty and tier info before donating your kit to the floor.",
                      "Tone (body, accent, warn, muted)": "body"
                    }
                  ]
                },
                {
                  "Heading": "HELP PAGES",
                  "Lines": [
                    {
                      "Text": "/hordehelp — Hordes rules and reminders",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "/raidbuilderinfo — vetted raidbase builder commands",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "/rbinfo — raidable bases overview",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "/pvpinfo — PvP zone reminders",
                      "Tone (body, accent, warn, muted)": "body"
                    }
                  ]
                }
              ]
            }
          ],
          "Show status": false,
          "About": [],
          "Rules title": null,
          "Rules": [],
