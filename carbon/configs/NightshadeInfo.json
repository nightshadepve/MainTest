      "Tabs": [
        {
          "Title": "Home",
          "Show status": true,
          "About": [
            {
              "Heading": "WELCOME TO NIGHTSHADE",
              "Lines": [
                {
                  "Text": "Nightshade is a cozy-but-feral hybrid PvPvE Rust server: PvE outside protected PvP areas, with monuments and event zones ready to bite.",
                  "Tone (body, accent, warn, muted)": "body"
                },
                {
                  "Text": "Vanilla gathering on resources, components, and food.",
                  "Tone (body, accent, warn, muted)": "body"
                },
                {
                  "Text": "10x+ stack sizes, with exceptions for balance.",
                  "Tone (body, accent, warn, muted)": "body"
                },
                {
                  "Text": "Monthly wipe: first Thursday at 2:00 PM Eastern, unless Discord says otherwise.",
                  "Tone (body, accent, warn, muted)": "body"
                },
                {
                  "Text": "Monuments are always PvP. Watch the zone warnings before wandering in.",
                  "Tone (body, accent, warn, muted)": "warn"
                },
                {
                  "Text": "Progression runs through /shop, Skill Tree, quarries, events, and VIP perks.",
                  "Tone (body, accent, warn, muted)": "body"
                },
                {
                  "Text": "Loot protection covers earned kills, crates, drops, and event rewards.",
                  "Tone (body, accent, warn, muted)": "body"
                },
                {
                  "Text": "Active admins. Read the rules on this page, then Commands, then /shop when you want to spend RP.",
                  "Tone (body, accent, warn, muted)": "body"
                }
              ]
            }
          ],
          "Rules title": "SERVER RULES",
          "Rules": [
            {
              "Heading": "BASES & BUILDING",
              "Lines": [
                {
                  "Text": "No raiding, damaging, griefing, laddering, walling in, trapping, or messing with player bases outside Purge or approved raid events.",
                  "Tone (body, accent, warn, muted)": "warn"
                },
                {
                  "Text": "Do not block roads, monuments, caves, vendors, event areas, or another player's build.",
                  "Tone (body, accent, warn, muted)": "warn"
                },
                {
                  "Text": "Build for style, defense, roleplay, and deeply suspicious architecture. That part is encouraged.",
                  "Tone (body, accent, warn, muted)": "body"
                }
              ]
            },
            {
              "Heading": "LOOT & OWNERSHIP",
              "Lines": [
                {
                  "Text": "Do not steal from player containers, bodies, drops, event crates, or protected loot.",
                  "Tone (body, accent, warn, muted)": "warn"
                },
                {
                  "Text": "If Loot Protection says it is not yours, it is not yours. This is not a riddle.",
                  "Tone (body, accent, warn, muted)": "warn"
                },
                {
                  "Text": "Team up or ask for share access when you want to split loot.",
                  "Tone (body, accent, warn, muted)": "body"
                }
              ]
            },
            {
              "Heading": "PVP",
              "Lines": [
                {
                  "Text": "PvP is allowed inside marked PvP monuments, PvP domes, PvP-enabled events, during the weekend window, and during Purge.",
                  "Tone (body, accent, warn, muted)": "body"
                },
                {
                  "Text": "The weekend window is Friday 8:00 PM through Monday 3:00 AM Eastern. The status cards above are the live reading.",
                  "Tone (body, accent, warn, muted)": "body"
                },
                {
                  "Text": "Outside those areas, do not attack, bait, exploit rules, or play loophole lawyer.",
                  "Tone (body, accent, warn, muted)": "warn"
                },
                {
                  "Text": "Watch entry and leave messages. If a dome looks spicy, assume it bites.",
                  "Tone (body, accent, warn, muted)": "body"
                }
              ]
            },
            {
              "Heading": "COMMUNITY",
              "Lines": [
                {
                  "Text": "No hate speech, harassment, stalking, threats, doxxing, slurs, cheating, exploiting, or ban evading.",
                  "Tone (body, accent, warn, muted)": "warn"
                },
                {
                  "Text": "Trash talk can be spicy. Do not make it personal, creepy, or radioactive.",
                  "Tone (body, accent, warn, muted)": "body"
                },
                {
                  "Text": "Admins have final say on edge cases. If you have to say \"technically,\" step away from the crime scene.",
                  "Tone (body, accent, warn, muted)": "body"
                }
              ]
            }
          ],
          "Discord title": "DISCORD",
          "Discord invite": "discord.gg/dFmeweQmsy",
          "Discord lines": [
            {
              "Text": "Wipe changes, events, and support are posted in Discord.",
              "Tone (body, accent, warn, muted)": "body"
            },
            {
              "Text": "Select the invite below if you want to copy it.",
              "Tone (body, accent, warn, muted)": "body"
            },
            {
              "Text": "Donations go through the store link in Discord. After you donate, post in the donation channel with your in-game name so an admin can apply VIP.",
              "Tone (body, accent, warn, muted)": "body"
            },
            {
              "Text": "VIP lasts until map wipe unless Discord says otherwise. VIPx follows the vipx group.",
              "Tone (body, accent, warn, muted)": "muted"
            }
          ],
          "Commands": [],
          "Columns": [],
          "Buttons": []
        }
      ],
      "Enabled": true
